<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_rounded"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="28dp">

        <!-- Drag Handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_bottom_sheet_handle"
            android:backgroundTint="?attr/grayTextColor" />

        <!-- Top Header Action Bar (Close & Favorite) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/dialogFavoriteButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/circle_background"
                android:backgroundTint="#20FFFFFF"
                android:contentDescription="@string/favorite"
                android:padding="9dp"
                android:src="@drawable/ic_baseline_bookmark_border_24" />

            <ImageView
                android:id="@+id/dialogCloseButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/circle_background"
                android:backgroundTint="#20FFFFFF"
                android:contentDescription="@string/close"
                android:padding="10dp"
                android:src="@drawable/ic_baseline_close_24"
                app:tint="?attr/textColor" />

        </RelativeLayout>

        <!-- Large Game Icon & Title Header Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="?attr/primaryGrayBackground"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeColor="?attr/dividerColor"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="20dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginBottom="14dp"
                    app:cardBackgroundColor="#10000000"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="4dp"
                    app:strokeColor="?attr/dividerColor"
                    app:strokeWidth="1.5dp">

                    <ImageView
                        android:id="@+id/dialogGameIcon"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/game_icon"
                        android:scaleType="centerCrop"
                        tools:src="@drawable/ic_game_placeholder" />

                </com.google.android.material.card.MaterialCardView>

                <!-- Game Title -->
                <TextView
                    android:id="@+id/dialogGameTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/google_sans"
                    android:gravity="center"
                    android:textColor="?attr/textColor"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="Subway Surfers" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- PLAY GAME Action Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/dialogBtnPlayGame"
            style="@style/WhiteButton"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="18dp"
            android:paddingHorizontal="36dp"
            android:minWidth="220dp"
            android:text="PLAY GAME NOW"
            app:icon="@drawable/ic_baseline_play_arrow_24" />

        <!-- Settings-Style Card Group: ABOUT GAME -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/dialogLayoutDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="?attr/primaryGrayBackground"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp"
            app:strokeColor="?attr/dividerColor"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="@font/google_sans"
                    android:letterSpacing="0.05"
                    android:text="ABOUT GAME"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/dialogGameDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/google_sans"
                    android:lineSpacingExtra="4dp"
                    android:textColor="?attr/textColor"
                    android:textSize="14sp"
                    tools:text="Poor Eddie always seems to end up in tricky situations!" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Settings-Style Card Group: HOW TO PLAY -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/dialogLayoutHowToPlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="?attr/primaryGrayBackground"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp"
            app:strokeColor="?attr/dividerColor"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="@font/google_sans"
                    android:letterSpacing="0.05"
                    android:text="HOW TO PLAY"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/dialogGameHowToPlay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/google_sans"
                    android:lineSpacingExtra="4dp"
                    android:textColor="?attr/textColor"
                    android:textSize="14sp"
                    tools:text="• Use your mouse or finger to click buttons and interact with environment." />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
