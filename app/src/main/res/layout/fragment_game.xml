<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/primaryBlackBackground">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/primaryBlackBackground"
        app:elevation="4dp"
        app:liftOnScroll="true"
        app:liftOnScrollTargetViewId="@id/gamesRecyclerView">

        <!-- Scrollable Header Top Area (Title + Saved Games Card) -->
        <LinearLayout
            android:id="@+id/headerTopSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="6dp"
            app:layout_scrollFlags="scroll">

            <!-- Instant Arcade Live Pill Badge -->
            <LinearLayout
                android:id="@+id/gameBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/bg_bottom_sheet_handle"
                android:backgroundTint="?attr/primaryGrayBackground"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/circle_background"
                    android:backgroundTint="#10B981" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/google_sans"
                    android:letterSpacing="0.08"
                    android:text="INSTANT ARCADE"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/gameTitleHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/google_sans"
                android:text="Explore Games"
                android:textColor="?attr/textColor"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/gameSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:alpha="0.85"
                android:fontFamily="@font/google_sans"
                android:text="Play instantly, no downloads needed"
                android:textColor="?attr/grayTextColor"
                android:textSize="13sp" />

            <!-- Saved Games Shortcut Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/savedGamesCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:foreground="?attr/selectableItemBackground"
                android:stateListAnimator="@animator/card_press_anim"
                app:cardBackgroundColor="?attr/primaryGrayBackground"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:strokeColor="?attr/dividerColor"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_bottom_sheet_handle"
                        android:backgroundTint="#10FFFFFF">

                        <ImageView
                            android:id="@+id/savedGamesIcon"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="6dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_saved" />

                        <TextView
                            android:id="@+id/savedGamesCount"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="top|end"
                            android:background="@drawable/circle_background"
                            android:backgroundTint="?attr/colorPrimary"
                            android:gravity="center"
                            android:text="0"
                            android:textColor="@android:color/white"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:visibility="gone" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/savedGamesTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/google_sans"
                            android:text="My Saved Games"
                            android:textColor="?attr/textColor"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/savedGamesSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/google_sans"
                            android:text="No games saved yet"
                            android:textColor="?attr/grayTextColor"
                            android:textSize="12.5sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_baseline_keyboard_arrow_right_24"
                        app:tint="?attr/grayTextColor" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Sticky Modern Search Bar Bar (Pinned at top when scrolling) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/primaryBlackBackground"
            android:paddingHorizontal="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="10dp">

            <!-- Modern Squircle Search Bar -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/searchCard"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                app:cardBackgroundColor="?attr/primaryGrayBackground"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/dividerColor"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/search_icon"
                        app:tint="?attr/colorPrimary" />

                    <EditText
                        android:id="@+id/searchEditText"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:background="@android:color/transparent"
                        android:fontFamily="@font/google_sans"
                        android:hint="Search games..."
                        android:inputType="text"
                        android:maxLines="1"
                        android:textColor="?attr/textColor"
                        android:textColorHint="?attr/grayTextColor"
                        android:textSize="14sp" />

                    <ImageView
                        android:id="@+id/searchClearButton"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="2dp"
                        android:src="@drawable/ic_baseline_close_24"
                        android:visibility="gone"
                        app:tint="?attr/grayTextColor" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main Content Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Loading Shimmer Effect -->
        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmerLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:shimmer_auto_start="true"
            app:shimmer_duration="1500">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">
                <include layout="@layout/shimmer_game_grid" />
            </LinearLayout>
        </com.facebook.shimmer.ShimmerFrameLayout>

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="100dp"
            android:indeterminateTint="?attr/colorPrimary"
            android:visibility="gone" />

        <!-- Games Grid -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/gamesRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="6dp"
            android:clipToPadding="false"
            android:layoutAnimation="@anim/layout_animation_game_grid"
            android:visibility="gone" />

        <TextView
            android:id="@+id/emptyTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="100dp"
            android:text="@string/games"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Beautiful Offline Screen -->
    <LinearLayout
        android:id="@+id/offlineScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone"
        android:background="?attr/primaryBlackBackground">

        <!-- Offline Icon with Lottie Animation -->
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/offlineLottie"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_marginBottom="24dp"
            app:lottie_fileName="no_internet.json"
            app:lottie_autoPlay="true"
            app:lottie_loop="true" />

        <!-- Offline Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="You're Offline"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="?attr/textColor"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

        <!-- Offline Description -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Please check your internet connection and try again."
            android:textSize="16sp"
            android:textColor="?attr/grayTextColor"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="32dp" />

        <!-- Shimmer Loading Effect -->
        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/offlineShimmer"
            android:layout_width="200dp"
            android:layout_height="48dp"
            app:shimmer_auto_start="true"
            app:shimmer_duration="1500"
            app:shimmer_repeat_mode="reverse">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/retryButton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Retry"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/textColor"
                app:backgroundTint="?attr/colorPrimary"
                app:cornerRadius="24dp" />
        </com.facebook.shimmer.ShimmerFrameLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
