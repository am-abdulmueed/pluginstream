<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_rounded"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <!-- Drag Handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_bottom_sheet_handle"
            android:backgroundTint="?attr/grayTextColor" />

        <!-- Header Row -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <!-- Icon -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/iconContainer"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                app:cardBackgroundColor="?attr/boxItemBackground"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="11dp"
                    android:src="@drawable/ic_baseline_system_update_24"
                    app:tint="?attr/textColor" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Title + Subtitle -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="14dp"
                android:layout_toEndOf="@id/iconContainer"
                android:layout_alignParentEnd="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/updateTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/google_sans"
                    android:text="New Update Available"
                    android:textColor="?attr/textColor"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/updateSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/google_sans"
                    android:text="A new version is ready to install"
                    android:textColor="?attr/grayTextColor"
                    android:textSize="12sp" />
            </LinearLayout>

            <!--
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/closeButtonCard"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:stateListAnimator="@animator/card_press_anim"
                app:cardBackgroundColor="?attr/boxItemBackground"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/closeButton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:padding="8dp"
                    android:src="@drawable/ic_baseline_close_24"
                    app:tint="?attr/grayTextColor" />
            </com.google.android.material.card.MaterialCardView>
            -->

        </RelativeLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="16dp"
            android:alpha="0.5"
            android:background="?attr/dividerColor" />

        <!-- Changelog Markdown -->
        <TextView
            android:id="@+id/updateChangelogText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/google_sans"
            android:lineSpacingExtra="4dp"
            android:textColor="?attr/textColor"
            android:textSize="14sp" />

        <!-- Divider above buttons -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="14dp"
            android:alpha="0.4"
            android:background="?attr/dividerColor" />

        <!-- Action Buttons (horizontally scrollable for small screens) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:fillViewport="false">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingEnd="4dp">

                <!-- Skip Update (only shown in auto-update mode) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/skipUpdateButton"
                    style="@style/BlackButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:text="@string/skip_update"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <!-- Cancel -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cancelButton"
                    style="@style/BlackButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:text="@string/cancel"
                    android:textSize="13sp" />

                <!-- Update -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/updateButton"
                    style="@style/WhiteButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="@string/update"
                    android:textSize="13sp" />

            </LinearLayout>
        </HorizontalScrollView>


    </LinearLayout>

</androidx.core.widget.NestedScrollView>
